{
  "name": "@okf/explorer",
  "private": true,
  "version": "0.5.7",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:determinism": "node scripts/check_deterministic_build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run && node --test scripts/app_build_manifest.test.mjs scripts/pages_fallback.test.mjs scripts/runtime_acceptance_contract.test.mjs scripts/external_bundle_acceptance_contract.test.mjs scripts/run_impacted_browser_tests.test.mjs",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:foundry": "playwright test --config=playwright.foundry.config.ts",
    "test:e2e:impacted": "node scripts/run_impacted_browser_tests.mjs",
    "test:e2e:terminal": "node scripts/run_impacted_browser_tests.mjs --full --engines-json '[\"chrome\",\"firefox\",\"webkit\"]'",
    "test:e2e:pages": "PLAYWRIGHT_BASE_URL=https://chris-page-gov.github.io/okf-explorer/ playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:build-manifest": "node --test scripts/app_build_manifest.test.mjs",
    "test:acceptance-contract": "node --test scripts/runtime_acceptance_contract.test.mjs",
    "test:external-acceptance-contract": "node --test scripts/external_bundle_acceptance_contract.test.mjs",
    "acceptance:bundle": "pnpm build:determinism && node scripts/run_external_bundle_acceptance.mjs",
    "acceptance:legislation": "pnpm build:determinism && node scripts/run_legislation_runtime_acceptance.mjs",
    "benchmark:search": "node ../../scripts/benchmark_static_search.mjs",
    "sbom": "node scripts/build_sbom.mjs",
    "sbom:check": "node scripts/build_sbom.mjs --check"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "^1.62.0",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "cookie": "^0.7.2"
    }
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}

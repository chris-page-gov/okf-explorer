{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true, "resolveJsonModule": true,
    "strict": true, "noEmit": true, "skipLibCheck": true,
    "lib": ["ES2023", "DOM"], "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}

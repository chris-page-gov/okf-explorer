{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chris-page-gov.github.io/okf-explorer/publication-units/publication-unit.v1.schema.json",
  "title": "OKF publication unit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "owner_repository",
    "publication",
    "runtime_dependency",
    "retarget",
    "activation",
    "materials"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schema": {"const": "okf-publication-unit.v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "owner_repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_url", "pages_base_url", "release_asset_prefix"],
      "properties": {
        "repository_url": {"type": "string", "format": "uri", "pattern": "^https://github.com/"},
        "pages_base_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "release_asset_prefix": {"type": "string", "minLength": 1}
      }
    },
    "runtime_dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "contract", "public_url"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "contract": {"type": "string", "minLength": 1},
        "public_url": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    },
    "retarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_base_url", "to_base_url"],
      "properties": {
        "from_base_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "to_base_url": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_remote_identity_journey", "redirects_after_activation"],
      "properties": {
        "requires_remote_identity_journey": {"const": true},
        "redirects_after_activation": {"type": "boolean"}
      }
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target", "role"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "role": {"enum": ["corpus", "fixture", "documentation", "policy", "licence"]}
        }
      }
    }
  }
}
